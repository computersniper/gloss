{
  "name": "gloss-local",
  "version": "2.0.0-beta.1",
  "description": "Gloss, a local AI paper reader with the GlossX research workbench.",
  "type": "module",
  "bin": {
    "gloss": "scripts/gloss.mjs",
    "gloss-local": "scripts/gloss.mjs",
    "glossx": "scripts/gloss.mjs",
    "glossx-local": "scripts/gloss.mjs"
  },
  "files": [
    "backend/app/**/*.py",
    "backend/app/**/*.json",
    "backend/requirements.txt",
    "frontend/dist/**",
    "scripts/gloss.mjs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computersniper/gloss.git"
  },
  "bugs": {
    "url": "https://github.com/computersniper/gloss/issues"
  },
  "homepage": "https://github.com/computersniper/gloss#readme",
  "scripts": {
    "setup": "node scripts/gloss.mjs setup",
    "start": "node scripts/gloss.mjs start",
    "dev": "node scripts/gloss.mjs dev",
    "doctor": "node scripts/gloss.mjs doctor --json",
    "test": "node scripts/gloss.mjs test",
    "build:frontend": "npm --prefix frontend ci --no-fund --no-audit && npm --prefix frontend run build",
    "prepack": "npm run build:frontend"
  }
}
